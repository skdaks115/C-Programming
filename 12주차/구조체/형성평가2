#include <stdio.h>
#include <string.h>

struct Contact {
    char name[101];
    char tel[101];
    char addr[101];
};

int main() {
    struct Contact people[3];

    for (int i = 0; i < 3; i++) {
        scanf("%100s %100s %100s", people[i].name, people[i].tel, people[i].addr);
    }

    int first_idx = 0;
    for (int i = 1; i < 3; i++) {
        if (strcmp(people[i].name, people[first_idx].name) < 0) {
            first_idx = i;
        }
    }

    printf("name : %s\n", people[first_idx].name);
    printf("tel : %s\n", people[first_idx].tel);
    printf("addr : %s\n", people[first_idx].addr);

    return 0;
}
