#include <stdio.h>

struct Student {
    char name[21];
    int height;
};

int main() {
    struct Student students[3];

    for (int i = 0; i < 3; i++) {
        scanf("%20s %d", students[i].name, &students[i].height);
    }

    for (int i = 0; i < 3; i++) {
        printf("%s : %dcm\n", students[i].name, students[i].height);
    }

    return 0;
}
