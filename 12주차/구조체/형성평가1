#include <stdio.h>

struct Contact {
    char name[101];
    char tel[101];
    char addr[101];
};

int main() {
    struct Contact person;

    scanf("%100s %100s %100s", person.name, person.tel, person.addr);

    printf("name : %s\n", person.name);
    printf("tel : %s\n", person.tel);
    printf("addr : %s\n", person.addr);

    return 0;
}
