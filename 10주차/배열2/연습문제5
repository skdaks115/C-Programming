#include <stdio.h>

int main() {
    int arr[4][3] = {
        {3, 5, 4},
        {2, 6, 7},
        {8, 10, 1},
        {5, 3, 15}
    };

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 3; j++) {
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }

    return 0;
}
