#include <stdio.h>

int main() {
    int arr[100];
    scanf("%d", &arr[1]);

    arr[0] = 100;
    printf("%d %d ", arr[0], arr[1]);

    int i = 2;
    while (1) {
        arr[i] = arr[i - 2] - arr[i - 1];
        printf("%d ", arr[i]);
        if (arr[i] < 0) {
            break;
        }
        i++;
    }
    printf("\n");

    return 0;
}
