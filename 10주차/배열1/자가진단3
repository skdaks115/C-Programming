#include <stdio.h>

int main() {
    int arr[100];
    int count = 0;

    while (count < 100) {
        int input;
        scanf("%d", &input);
        if (input == 0) {
            break;
        }
        arr[count] = input;
        count++;
    }

    for (int i = count - 1; i >= 0; i--) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
