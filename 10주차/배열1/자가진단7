#include <stdio.h>

int main() {
    int arr[10];
    int even_sum = 0;
    int odd_sum = 0;

    for (int i = 0; i < 10; i++) {
        scanf("%d", &arr[i]);
        if (i % 2 == 1) {
            even_sum += arr[i];
        } else {
            odd_sum += arr[i];
        }
    }

    double odd_avg = (double)odd_sum / 5;

    printf("sum : %d\n", even_sum);
    printf("avg : %.1f\n", odd_avg);

    return 0;
}
