#include <stdio.h>

int main() {
    int even_count = 0;
    int odd_count = 0;
    int num;
    
    for (int i = 0; i < 10; i++) {
        scanf("%d", &num);
        if (num % 2 == 0) {
            even_count++;
        } else {
            odd_count++;
        }
    }
    
    printf("even : %d\n", even_count);
    printf("odd : %d\n", odd_count);
    
    return 0;
}
