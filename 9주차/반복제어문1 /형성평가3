#include <stdio.h>

int main() {
    int num;
    int sum = 0;
    int count = 0;
    double avg;

    while (1) {
        scanf("%d", &num);

        if (num < 0 || num > 100) {
            break;
        }

        sum += num;
        count++;
    }

    avg = (double)sum / count;

    printf("sum : %d\n", sum);
    printf("avg : %.1f\n", avg);

    return 0;
}
