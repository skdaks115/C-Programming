#include <stdio.h>

int main() {
    int num;

    while (1) {
        printf("1. Input\n");
        printf("2. Output\n");
        printf("3. Delete\n");
        printf("4. Finish\n");
        printf("Enter number: ");

        scanf("%d", &num);

        switch (num) {
            case 1:
                printf("\nYou selected Input.\n\n");
                break;

            case 2:
                printf("\nYou selected Output.\n\n");
                break;

            case 3:
                printf("\nYou selected Delete.\n\n");
                break;

            case 4:
                printf("\nYou selected Finish.\n");
                return 0;

            default:
                printf("\nWrong input.\n\n");
        }
    }

    return 0;
}
