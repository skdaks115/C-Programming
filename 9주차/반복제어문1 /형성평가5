#include <stdio.h>

int main() {
    double base, height;
    char again;

    while (1) {
        if (scanf("%lf %lf", &base, &height) != 2) {
            break;
        }

        double area = (base * height) / 2.0;
        printf("Triangle width = %.1lf\n", area);

        printf("Continue? ");

        scanf(" %c", &again);

        if (again != 'Y' && again != 'y') {
            break;
        }
    }

    return 0;
}
