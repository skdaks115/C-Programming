#include <stdio.h>

int main() {
    int num;

    while (1) {
        printf("1. Korea\n");
        printf("2. USA\n");
        printf("3. Japan\n");
        printf("4. China\n");
        printf("number?\n");

        scanf("%d", &num);

        switch (num) {
            case 1:
                printf("Seoul\n\n");
                break;

            case 2:
                printf("Washington\n\n");
                break;

            case 3:
                printf("Tokyo\n\n");
                break;

            case 4:
                printf("Beijing\n\n");
                break;

            default:
                printf("none\n");
                return 0;
        }
    }

    return 0;
}
