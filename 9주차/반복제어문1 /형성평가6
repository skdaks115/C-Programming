#include <iostream>
using namespace std;

int main() {
    int x = 50;           // 초기값
    cin >> x;             // [A] 이 줄에 커서가 있을 때 x 값 확인

    if (x >= 80) {      
        x += 10;        // [B] 이 줄에 커서가 있을 때 x 값 확인
    } else {            
        x -= 5;         // [B] 이 줄에 커서가 있을 때 x 값 확인
    }
    x--;                // [C] 이 줄에 커서가 있을 때 x 값 확인

    int A = 75;           // [A]에서 확인한 값으로 수정
    int B = 70;           // [B]에서 확인한 값으로 수정 (두 군데중 하나만 해당)
    int C = 69;           // [C]에서 확인한 값으로 수정

    cout << A << " " << B << " " << C << '\n';
    return 0;
}
